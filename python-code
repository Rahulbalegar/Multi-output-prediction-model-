# Unwrap model to get a tree-based estimator for SHAP
def get_tree_estimator(model):
    """Returns the underlying tree estimator if available, else None."""
    m = model
    # Peel Pipeline
    if hasattr(m, 'named_steps'):
        m = m.named_steps.get('m', m)
    # Peel MultiOutputRegressor
    if hasattr(m, 'estimators_'):
        try:
            # RF/ET: estimators_ are trees
            _ = m.estimators_[0].predict  # will fail if its a MOR
            return m  # native multi-output tree model
        except Exception:
            pass
    return m

try:
    base = get_tree_estimator(best_model)
    if isinstance(base, (RandomForestRegressor, ExtraTreesRegressor)):
        explainer = shap.TreeExplainer(base)
        # shap_values shape: [n_outputs][n_samples, n_features]  or  [n_samples, n_features, n_outputs]
        sv = explainer.shap_values(shap_X)
        # Normalize to list of [n_samples, n_features] arrays (one per target)
        if isinstance(sv, list):
            shap_values_all = sv  # already [n_outputs][n_samples, n_features]
        elif isinstance(sv, np.ndarray) and sv.ndim == 3:
            shap_values_all = [sv[:, :, i] for i in range(sv.shape[2])]
        else:
            shap_values_all = [sv] * 4
        print(f"  SHAP computed for {best_name} ({len(shap_values_all)} outputs)")
    elif hasattr(base, 'estimators_') and hasattr(base.estimators_[0], 'estimators_'):
        # MultiOutputRegressor wrapping a tree model
        shap_values_all = []
        for est in base.estimators_:
            exp = shap.TreeExplainer(est)
            sv  = exp.shap_values(shap_X)
            shap_values_all.append(sv if sv.ndim == 2 else sv[:, :, 0])
        print(f"  SHAP computed via MOR for {best_name}")
    else:
        print(f"  SHAP skipped (model not tree-based): {type(base).__name__}")
