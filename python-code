def tree_pred_intervals(model, X, pct=90):
    alpha = (100 - pct) / 2
    base  = get_tree_estimator(model)
    if isinstance(base, (RandomForestRegressor, ExtraTreesRegressor)):
        # shape: [n_estimators, n_samples, n_outputs]
        tree_preds = np.array([t.predict(X) for t in base.estimators_])
        mean_p = tree_preds.mean(axis=0)
        lo_p   = np.percentile(tree_preds, alpha, axis=0)
        hi_p   = np.percentile(tree_preds, 100 - alpha, axis=0)
        return mean_p, lo_p, hi_p
    else:
        p = model.predict(X)
        return p, p, p

