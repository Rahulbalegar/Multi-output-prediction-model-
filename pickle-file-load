print("Figure 2: KDE distributions")
plot_cols = CONTINUOUS + TARGETS
for col in plot_cols:
    real  = train_raw[col].values
    synth = synthetic[col].values
    xlo   = min(real.min(), synth.min())
    xhi   = max(real.max(), synth.max())
    xs    = np.linspace(xlo - 0.05*(xhi-xlo), xhi + 0.05*(xhi-xlo), 300)
    kr    = gaussian_kde(real,  bw_method='silverman')
    ks    = gaussian_kde(synth, bw_method='silverman')
    bins  = np.linspace(xlo, xhi, 50)
    p, _  = np.histogram(real,  bins=bins, density=True); p += 1e-10
    q, _  = np.histogram(synth, bins=bins, density=True); q += 1e-10
    jsd   = jensenshannon(p, q) ** 2

    fig, ax = plt.subplots(figsize=FIG_SINGLE)
    ax.fill_between(xs, kr(xs), alpha=0.2, color=C_REAL)
    ax.fill_between(xs, ks(xs), alpha=0.2, color=C_SYNTH)
    ax.plot(xs, kr(xs), color=C_REAL,  lw=2, label='Experimental')
    ax.plot(xs, ks(xs), color=C_SYNTH, lw=2, label='Synthetic')
    ax.text(0.04, 0.96, f'JSD = {jsd:.2f}',
            transform=ax.transAxes, fontsize=FONT_SIZE_ANNOT,
            va='top', ha='left',
            bbox=dict(boxstyle='round,pad=0.3', facecolor='white', alpha=0.8, edgecolor='none'))
    ax.set_xlabel(XAXIS_LABELS.get(col, col), fontsize=FONT_SIZE_AXIS)
    ax.set_ylabel('Density', fontsize=FONT_SIZE_AXIS)
    ax.set_title('')
    ax.legend(loc=LEGEND_LOC, ncol=LEGEND_NCOL)
    add_border(ax)
    ax.grid(False)
    plt.tight_layout()
    safe = col.replace(' ', '_').replace('/', '').replace("'", '')
    savefig(fig, f'fig02_kde_{safe}')

