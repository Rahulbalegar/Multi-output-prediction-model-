def predict_new(feature_dict):
    x = np.array([[feature_dict.get(f, 0.0) for f in FEATURES]])
    y = best_model.predict(x)[0]
    return dict(zip(TARGETS, y))

def run_inference_cli():
    SCM_OPTIONS    = {'CC':'Calcined Clay','VA':'Volcanic Ash','FBC':'FBC Ash',
                      'SC':'Slag Cement','GBA':'Ground BF Ash','FA':'Fly Ash'}
    CEMENT_OPTIONS = {'PC':'Portland Cement','PLC':'Portland Limestone Cement'}

    def get_float(prompt):
        while True:
            try: return float(input(prompt))
            except ValueError: print("  Enter a number.")

    mix_num = 1
    while True:
        print(f"\n--- Mixture {mix_num} ---")
        label = input("Mixture label (or 'done' to finish): ").strip()
        if label.lower() == 'done':
            break

        print("\nCement type: " + "  |  ".join(f"{k} = {v}" for k,v in CEMENT_OPTIONS.items()))
        while True:
            ct = input("Enter PC or PLC: ").strip().upper()
            if ct in CEMENT_OPTIONS: break
            print("  Enter PC or PLC.")
        cp = get_float(f"  {ct} proportion (%): ")

        gp = get_float("\nGP proportion (%): ")

        print("\nSCM: " + "  |  ".join(f"{k} = {v}" for k,v in SCM_OPTIONS.items()))
        while True:
            st = input("Enter SCM code: ").strip().upper()
            if st in SCM_OPTIONS: break
            print("  Not recognised.")
        sp = get_float(f"  {st} proportion (%): ")

        total = cp + gp + sp
        print(f"  Blend total: {total:.1f}%" + ("  should sum to 100%" if abs(total-100)>1 else ""))

        fd = {}
        fd[ct]                 = cp
        fd['GP']               = gp
        fd[st]                 = sp
        fd['W/C Ratio']        = get_float("\nW/C ratio: ")
        fd['D10']              = get_float("D10 (μm): ")
        fd['D50']              = get_float("D50 (μm): ")
        fd['D90']              = get_float("D90 (μm): ")
        fd['Amorphous content']= get_float("Amorphous content (%): ")
        fd['Heat Release']     = get_float("Heat release (J/g): ")
        fd['Bound Water']      = get_float("Bound water (g/100g paste): ")
        fd['CH Consumption']   = get_float("CH consumption (g/100g SCM): ")

        preds = predict_new(fd)

        print(f"\nPredictions for '{label}':")
        print(f"  {'Age':<12}  {'Predicted (MPa)':>16}")
        print(f"  {'-'*32}")
        for age, val in preds.items():
            print(f"  {age:<12}  {val:>16.2f}")

        mix_num += 1
    print("\nInference complete.")

run_inference_cli()
